# ============================================================
# Trace Network & Engineering — Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values.
# ============================================================

# ─── API ─────────────────────────────────────────────────────
# Development: points to your local Express server
VITE_API_URL=http://localhost:5000/api

# Production: points to your deployed backend (Render / Railway / etc.)
# VITE_API_URL=https://trace-backed-1.onrender.com/api

VITE_API_TIMEOUT=10000

# ─── Supabase (public anon key — safe to expose in frontend) ─
# Used only if you add client-side Supabase queries (e.g. real-time)
# Get from: https://app.supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── App ─────────────────────────────────────────────────────
VITE_APP_NAME=Trace Network & Engineering
VITE_APP_URL=https://tracenetwork.in

# ─── Feature Flags ───────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHATBOT=true

# ─── Google Analytics ────────────────────────────────────────
VITE_GA_TRACKING_ID=G-5QYGDDYL0Q
