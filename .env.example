# ============================================================
# Trace Network & Engineering — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── JWT ─────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ─── Email (Nodemailer / Gmail SMTP / Custom) ─────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
CONTACT_TO_EMAIL=Support@tracenetwork.in
CAREER_TO_EMAIL=hr@tracenetwork.in


# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
